# Track only the curated final-report package; retain earlier local work privately.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/requirements.txt
!/CITATION.cff
!/src/
!/scripts/
!/tests/
!/notebooks/
!/data/
!/results/
!/paper/

__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store
.matplotlib/
.ruff_cache/
/results/*
!/results/reference/
!/results/validation/
*.aux
*.log
*.out
*.blg
*.synctex.gz
